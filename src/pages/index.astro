---
import { getCollection } from "astro:content";
import ContactActions from "../components/ContactActions.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getJobStatusContent } from "../data/job-status";
import { landingScopeCopy, professionalHighlights, skillGroups } from "../data/landing";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/showcase.css";
import "../styles/hero-proof.css";
import "../styles/landing-sections.css";

const projects = (await getCollection("projects")).sort(
  (leftProject, rightProject) => leftProject.data.order - rightProject.data.order,
);
const jobStatus = getJobStatusContent("ko", "actively-looking");
---

<BaseLayout
  title="개발자 김용범의 포트폴리오"
  description="프론트엔드 구현을 중심으로 데이터 흐름, 문서화와 검증 가능한 결과물을 함께 정리하는 웹 개발자 김용범의 포트폴리오"
>
  <main id="main-content">
    <section id="intro" class="hero-section" aria-labelledby="portfolio-title">
      <div class="site-shell hero-layout">
        <div class="hero-copy">
          <div class="hero-meta">
            <dl class="job-status">
              <div class="job-status__field">
                <dt>{jobStatus.fieldLabel}</dt>
                <dd>{jobStatus.valueLabel}</dd>
              </div>
            </dl>
            <p class="eyebrow">프론트엔드에 강한 웹 개발자</p>
          </div>
          <h1 id="portfolio-title">웹 개발자 김용범의 포트폴리오</h1>
          <p class="hero-positioning">
            사용자가 <span class="hero-positioning__accent">이해하기 쉬운 UI</span>와{" "}
            <span class="hero-positioning__accent">오래 관리할 수 있는 웹 제품</span>을 만듭니다.
          </p>
          <p class="hero-summary">
            프론트엔드 구현에 강점을 둔 개발자 김용범입니다. 데이터 흐름을 명확히 설계하고, 문서와
            검증 가능한 결과물을 함께 남깁니다.
          </p>
          <p class="hero-support">
            {landingScopeCopy.heroSupport}
          </p>
          <ContactActions />
        </div>

        <aside class="hero-proof" aria-labelledby="hero-proof-title">
          <div class="hero-proof__header">
            <img src="/assets/brand/logo-mark.svg" alt="" width="96" height="96" />
            <div>
              <p class="eyebrow">{landingScopeCopy.heroProof.eyebrow}</p>
              <p id="hero-proof-title" class="hero-proof__title">
                {landingScopeCopy.heroProof.title}
              </p>
            </div>
          </div>
          <dl>
            <div>
              <dt>{landingScopeCopy.heroProof.publicProjects.label}</dt>
              <dd>
                {projects.length}개 · {landingScopeCopy.heroProof.publicProjects.detail}
              </dd>
            </div>
            <div>
              <dt>{landingScopeCopy.heroProof.professionalExperience.label}</dt>
              <dd>
                {professionalHighlights.length}개 · {
                  landingScopeCopy.heroProof.professionalExperience.detail
                }
              </dd>
            </div>
            <div>
              <dt>{landingScopeCopy.heroProof.reviewOrder.label}</dt>
              <dd>{landingScopeCopy.heroProof.reviewOrder.value}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section id="projects" class="content-section" aria-labelledby="projects-title">
      <div class="site-shell">
        <div class="section-heading section-heading--split">
          <div class="section-heading__title">
            <p class="eyebrow">{landingScopeCopy.projects.eyebrow}</p>
            <h2 id="projects-title">프로젝트</h2>
          </div>
          <p>{landingScopeCopy.projects.description}</p>
          <span class="section-index" aria-hidden="true">01</span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, projectIndex) => (
              <ProjectCard
                cardNumber={String(projectIndex + 1).padStart(2, "0")}
                classification={project.data.classification}
                demoAccess={project.data.demoAccess}
                featured={projectIndex === 0}
                links={project.data.links}
                role={project.data.role}
                slug={project.id}
                summary={project.data.summary}
                tags={project.data.tags}
                title={project.data.title}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="professional-highlights"
      class="content-section professional-section"
      aria-labelledby="professional-highlights-title"
    >
      <div class="site-shell">
        <div class="section-heading section-heading--split">
          <div class="section-heading__title">
            <p class="eyebrow">{landingScopeCopy.professionalExperience.eyebrow}</p>
            <h2 id="professional-highlights-title">
              {landingScopeCopy.professionalExperience.title}
            </h2>
          </div>
          <p>{landingScopeCopy.professionalExperience.description}</p>
          <span class="section-index" aria-hidden="true">02</span>
        </div>

        <div class="professional-grid">
          {
            professionalHighlights.map((highlight, highlightIndex) => (
              <article class="professional-card">
                <span class="professional-card__index" aria-hidden="true">
                  {String(highlightIndex + 1).padStart(2, "0")}
                </span>
                <div class="professional-card__content">
                  <p class="professional-card__scope">
                    {landingScopeCopy.professionalExperience.scopeLabel}
                  </p>
                  <h3>{highlight.title}</h3>
                  <p class="professional-card__description">{highlight.description}</p>
                </div>
                <ul class="tag-list">
                  {highlight.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {highlight.action && (
                  <a class="text-link" href={highlight.action.href}>
                    {highlight.action.label}
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="skills"
      class="content-section content-section--tinted"
      aria-labelledby="skills-title"
    >
      <div class="site-shell">
        <div class="section-heading section-heading--split">
          <div class="section-heading__title">
            <p class="eyebrow">핵심 역량</p>
            <h2 id="skills-title">역량</h2>
          </div>
          <p>기술 이름을 나열하기보다 제품을 끝까지 전달하는 데 어떻게 활용했는지 설명합니다.</p>
          <span class="section-index" aria-hidden="true">03</span>
        </div>

        <ul class="capability-grid">
          {
            skillGroups.map((skillGroup) => (
              <li>
                <h3>{skillGroup.title}</h3>
                <p>{skillGroup.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="process" class="content-section" aria-labelledby="process-title">
      <div class="site-shell process-layout">
        <div class="section-heading section-heading--split">
          <div class="section-heading__title">
            <p class="eyebrow">작업 흐름</p>
            <h2 id="process-title">작업 방식</h2>
          </div>
          <p>작은 제품에서도 의사결정과 검증 근거가 구현과 함께 남도록 합니다.</p>
          <span class="section-index" aria-hidden="true">04</span>
        </div>

        <ol class="process-list">
          <li><strong>확인</strong><span>요구사항과 현재 구조를 먼저 읽습니다.</span></li>
          <li>
            <strong>구현</strong><span>책임과 데이터 흐름이 드러나는 작은 단위로 만듭니다.</span>
          </li>
          <li>
            <strong>검증</strong><span>정적 분석, 접근성 검사와 운영용 빌드로 확인합니다.</span>
          </li>
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>
