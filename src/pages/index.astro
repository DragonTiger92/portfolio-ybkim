---
import { getCollection } from "astro:content";
import CapabilityMatrix from "../components/CapabilityMatrix.astro";
import ContactActions from "../components/ContactActions.astro";
import NewWindowLink from "../components/NewWindowLink.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TagList from "../components/TagList.astro";
import TechStack from "../components/TechStack.astro";
import { getJobStatusContent } from "../data/job-status";
import { companyProjectHighlights, landingScopeCopy } from "../data/landing";
import { capabilityGroups, techStackGroups } from "../data/skills";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/showcase.css";
import "../styles/landing-sections.css";
import "../styles/technology-marks.css";

const projects = (await getCollection("projects")).sort(
  (leftProject, rightProject) => leftProject.data.order - rightProject.data.order,
);
const jobStatus = getJobStatusContent("ko", "actively-looking");
---

<BaseLayout
  title="개발자 김용범의 포트폴리오"
  description="프론트엔드 구현을 중심으로 데이터 흐름, 문서화와 검증 가능한 결과물을 함께 정리하는 웹 개발자 김용범의 포트폴리오"
>
  <main id="main-content">
    <section id="intro" class="hero-section" aria-labelledby="portfolio-title">
      <div class="site-shell hero-layout">
        <div class="hero-copy">
          <h1 id="portfolio-title" class="visually-hidden">웹 개발자 김용범의 포트폴리오</h1>
          <dl class="job-status">
            <div class="job-status__field">
              <dt>{jobStatus.fieldLabel}</dt>
              <dd>{jobStatus.valueLabel}</dd>
            </div>
          </dl>
          <p class="hero-positioning">
            <span class="hero-positioning__line">
              <span class="hero-positioning__accent">최종 사용자</span>와 <span
                class="hero-positioning__accent">개발자</span
              > 모두를 만족시키는{" "}
            </span>
            <span class="hero-positioning__line">제품 구현을 지향합니다.</span>
          </p>
          <ContactActions />
        </div>
      </div>
    </section>

    <section id="projects" class="content-section" aria-labelledby="projects-title">
      <div class="site-shell">
        <div class="section-heading section-heading--compact">
          <div class="section-heading__title">
            <h2 id="projects-title">프로젝트</h2>
          </div>
        </div>

        <div class="project-groups">
          <section class="project-group" aria-labelledby="public-projects-title">
            <div class="project-group__heading">
              <div>
                <h3 id="public-projects-title">{landingScopeCopy.projects.publicGroup.title}</h3>
              </div>
            </div>

            <div class="project-grid">
              {
                projects.map((project, projectIndex) => (
                  <ProjectCard
                    cardNumber={String(projectIndex + 1).padStart(2, "0")}
                    classification={project.data.classification}
                    featured={projectIndex === 0}
                    links={project.data.links}
                    role={project.data.role}
                    slug={project.id}
                    summary={project.data.summary}
                    tags={project.data.tags}
                    title={project.data.title}
                  />
                ))
              }
            </div>
          </section>

          <section
            class="project-group project-group--company"
            aria-labelledby="company-projects-title"
          >
            <div class="project-group__heading">
              <div>
                <h3 id="company-projects-title">{landingScopeCopy.projects.companyGroup.title}</h3>
              </div>
              <p>{landingScopeCopy.projects.companyGroup.description}</p>
            </div>

            <div class="professional-grid">
              {
                companyProjectHighlights.map((highlight, highlightIndex) => (
                  <article class="professional-card">
                    <span class="professional-card__index" aria-hidden="true">
                      {String(highlightIndex + 1).padStart(2, "0")}
                    </span>
                    <div class="professional-card__content">
                      <p class="professional-card__scope">
                        {landingScopeCopy.projects.companyGroup.scopeLabel}
                      </p>
                      <h4>{highlight.title}</h4>
                      <p class="professional-card__description">{highlight.description}</p>
                    </div>
                    <TagList items={highlight.tags} />
                    {highlight.action && (
                      <NewWindowLink
                        class="text-link"
                        href={highlight.action.href}
                        accessibleLabel={highlight.action.label}
                      >
                        {highlight.action.label}
                      </NewWindowLink>
                    )}
                  </article>
                ))
              }
            </div>
          </section>
        </div>
      </div>
    </section>

    <section
      id="skills"
      class="content-section content-section--tinted"
      aria-labelledby="skills-title"
    >
      <div class="site-shell">
        <div class="section-heading section-heading--split">
          <div class="section-heading__title">
            <h2 id="skills-title">역량</h2>
          </div>
          <p>사용한 기술과 실제 저장소에서 확인할 수 있는 구현 역량을 함께 보여드립니다.</p>
        </div>

        <TechStack groups={techStackGroups} />

        <CapabilityMatrix capabilities={capabilityGroups} />
      </div>
    </section>
  </main>
  <script src="../scripts/navigation-progress.ts"></script>
</BaseLayout>
