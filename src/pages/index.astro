---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/showcase.css";

const projects = (await getCollection("projects")).sort(
  (leftProject, rightProject) => leftProject.data.order - rightProject.data.order,
);

interface ProfessionalHighlight {
  action?: {
    href: string;
    label: string;
  };
  description: string;
  tags: string[];
  title: string;
}

const professionalHighlights: ProfessionalHighlight[] = [
  {
    title: "학원 정보·상담 웹 서비스",
    description:
      "학원 정보 탐색과 상담 접수를 연결하는 공개 서비스에서 기획, UI, API·데이터 연동, release 준비와 인수인계까지 제품 전달 흐름을 경험했습니다.",
    tags: ["Planning to handover", "UI · API · Data", "Public product"],
    action: {
      label: "공개 서비스 보기",
      href: "https://academy.shine-edu.kr/",
    },
  },
  {
    title: "과학 문항 개념·풀이 논리 구조화 도구",
    description:
      "인증·세션 기반, 초기 목록과 입력 폼 구조, 타입 경계, server-state 조회 흐름을 구현하고 후속 작업이 이어질 수 있도록 인계했습니다.",
    tags: ["Frontend foundations", "Typed boundaries", "Handover"],
  },
  {
    title: "과학 교육 콘텐츠 제작·검수 플랫폼",
    description:
      "기존 내부 업무 플랫폼을 이어받아 데이터 일관성, 안전한 파일 처리, 복구 준비, 문서화와 운영 안정성을 관리했습니다.",
    tags: ["Inherited system", "Reliability", "Documentation"],
  },
];

const skillGroups = [
  {
    title: "프론트엔드 구현",
    description: "Semantic HTML, TypeScript, CSS와 접근성을 제품 구조 안에서 함께 다룹니다.",
  },
  {
    title: "제품 전달",
    description: "요구사항, 범위, 문서와 검증 기준을 구현 과정과 연결합니다.",
  },
  {
    title: "통합 이해",
    description: "API, 데이터 흐름, 배포와 release boundary를 이해하고 협업합니다.",
  },
  {
    title: "유지보수",
    description: "명시적인 책임, 타입 안정성과 자동화된 quality gate를 선호합니다.",
  },
];
---

<BaseLayout
  title="개발자 김용범의 포트폴리오"
  description="프론트엔드 구현을 중심으로 데이터 흐름, 문서화와 검증 가능한 결과물을 함께 정리하는 웹 개발자 김용범의 포트폴리오"
>
  <main id="main-content">
    <section id="intro" class="hero-section" aria-labelledby="portfolio-title">
      <div class="site-shell hero-layout">
        <div class="hero-copy">
          <p class="status-tag">새로운 웹 개발자 기회에 열려 있습니다</p>
          <p class="eyebrow">Web Developer · Frontend-focused delivery</p>
          <h1 id="portfolio-title">
            사용자가 이해하기 쉬운 UI와 오래 관리할 수 있는 웹 제품을 만듭니다.
          </h1>
          <p class="hero-summary">
            프론트엔드 구현을 중심으로 데이터 흐름, 문서화, 검증 가능한 결과물을 함께 정리하는
            개발자 김용범입니다.
          </p>
          <p class="hero-support">
            Astro 기반 포트폴리오, Karly, Book-Kong, 그리고 공개 가능한 전문 작업을 통해
            구현·협업·인수인계 역량을 확인할 수 있게 합니다.
          </p>
          <div class="action-list">
            <a class="button-link" href="mailto:dczwtu12b+portfolio@gmail.com">이메일로 연락하기</a>
            <a
              class="button-link button-link--secondary"
              href="https://github.com/DragonTiger92/portfolio-ybkim">GitHub 보기</a
            >
            <a
              class="button-link button-link--tertiary"
              href="/assets/resume/yb-kim-resume.pdf"
              aria-label="이력서 PDF 다운로드"
              download>이력서 PDF</a
            >
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="content-section" aria-labelledby="projects-title">
      <div class="site-shell">
        <div class="section-heading">
          <p class="eyebrow">Evidence</p>
          <h2 id="projects-title">프로젝트</h2>
          <p>역할, 문제와 결과를 빠르게 검토할 수 있는 공개 가능한 사례입니다.</p>
        </div>

        <div class="project-grid">
          {
            projects.map((project) => (
              <ProjectCard
                classification={project.data.classification}
                links={project.data.links}
                role={project.data.role}
                slug={project.id}
                summary={project.data.summary}
                tags={project.data.tags}
                title={project.data.title}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="professional-highlights"
      class="content-section professional-section"
      aria-labelledby="professional-highlights-title"
    >
      <div class="site-shell">
        <div class="section-heading">
          <p class="eyebrow">Professional work</p>
          <h2 id="professional-highlights-title">전문 작업 하이라이트</h2>
          <p>공개 가능한 범위에서 제품 전달, 프론트엔드 기반, 운영 안정성 경험을 요약했습니다.</p>
        </div>

        <div class="professional-grid">
          {
            professionalHighlights.map((highlight) => (
              <article class="professional-card">
                <div class="professional-card__content">
                  <h3>{highlight.title}</h3>
                  <p>{highlight.description}</p>
                </div>
                <ul class="tag-list">
                  {highlight.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {highlight.action && (
                  <a class="text-link" href={highlight.action.href}>
                    {highlight.action.label}
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="skills"
      class="content-section content-section--tinted"
      aria-labelledby="skills-title"
    >
      <div class="site-shell">
        <div class="section-heading">
          <p class="eyebrow">Capabilities</p>
          <h2 id="skills-title">역량</h2>
          <p>도구 목록보다 제품을 전달하는 책임을 중심으로 기술을 설명합니다.</p>
        </div>

        <ul class="capability-grid">
          {
            skillGroups.map((skillGroup) => (
              <li>
                <h3>{skillGroup.title}</h3>
                <p>{skillGroup.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="process" class="content-section" aria-labelledby="process-title">
      <div class="site-shell process-layout">
        <div class="section-heading">
          <p class="eyebrow">Delivery</p>
          <h2 id="process-title">작업 방식</h2>
          <p>작은 제품에서도 의사결정과 검증 근거가 구현과 함께 남도록 합니다.</p>
        </div>

        <ol class="process-list">
          <li><strong>확인</strong><span>요구사항과 현재 구조를 먼저 읽습니다.</span></li>
          <li>
            <strong>구현</strong><span>책임과 데이터 흐름이 드러나는 작은 단위로 만듭니다.</span>
          </li>
          <li>
            <strong>검증</strong><span>정적 분석, 접근성 검사와 production build로 확인합니다.</span
            >
          </li>
        </ol>
      </div>
    </section>

    <section
      id="repository"
      class="content-section repository-section"
      aria-labelledby="repository-title"
    >
      <div class="site-shell repository-layout">
        <div>
          <p class="eyebrow">Open repository</p>
          <h2 id="repository-title">저장소</h2>
          <p>요구사항, ADR, source와 quality gate를 함께 공개해 작업 과정을 검토할 수 있습니다.</p>
        </div>
        <a class="button-link" href="https://github.com/DragonTiger92/portfolio-ybkim"
          >GitHub에서 확인</a
        >
      </div>
    </section>
  </main>
</BaseLayout>
