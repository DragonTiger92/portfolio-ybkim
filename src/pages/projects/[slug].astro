---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface ProjectNavigationTarget {
  slug: string;
  title: string;
}

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (leftProject, rightProject) => leftProject.data.order - rightProject.data.order,
  );
  const toNavigationTarget = (
    project: CollectionEntry<"projects"> | undefined,
  ): ProjectNavigationTarget | null => {
    if (!project) {
      return null;
    }

    return {
      slug: project.id,
      title: project.data.title,
    };
  };

  return projects.map((project, projectIndex) => ({
    params: { slug: project.id },
    props: {
      nextProject: toNavigationTarget(projects[projectIndex + 1]),
      previousProject: toNavigationTarget(projects[projectIndex - 1]),
      project,
    },
  }));
}

interface Props {
  nextProject: ProjectNavigationTarget | null;
  previousProject: ProjectNavigationTarget | null;
  project: CollectionEntry<"projects">;
}

const { nextProject, previousProject, project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | 개발자 김용범의 포트폴리오`}
  description={project.data.summary}
>
  <main id="main-content" class="project-main">
    <article class="site-shell project-article">
      <nav class="breadcrumb" aria-label="현재 위치">
        <ol>
          <li><a href="/">포트폴리오</a></li>
          <li aria-current="page">{project.data.title}</li>
        </ol>
      </nav>

      <header class="project-header">
        <p class="eyebrow">{project.data.classification}</p>
        <h1>{project.data.title}</h1>
        <p class="project-summary">{project.data.summary}</p>

        <dl class="project-facts">
          <div>
            <dt>역할</dt>
            <dd>{project.data.role}</dd>
          </div>
          <div>
            <dt>기여 범위</dt>
            <dd>{project.data.contribution}</dd>
          </div>
          <div>
            <dt>초점</dt>
            <dd>{project.data.focus}</dd>
          </div>
        </dl>
      </header>

      <div class="project-review-grid">
        <div class="prose">
          <Content />
        </div>

        <aside class="project-supporting" aria-label="프로젝트 공개 근거와 지원 기술">
          {
            project.data.links.length > 0 && (
              <section class="project-links" aria-labelledby="project-links-title">
                <h2 id="project-links-title">공개 근거</h2>
                <p>
                  공개 저장소, 배포 결과와 문서에서 이 프로젝트의 범위와 결과를 확인할 수 있습니다.
                </p>
                <ul>
                  {project.data.links.map((link, linkIndex) => (
                    <li>
                      <a
                        class:list={["button-link", { "button-link--secondary": linkIndex > 0 }]}
                        href={link.href}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section class="project-stack" aria-labelledby="project-stack-title">
            <h2 id="project-stack-title">지원 기술</h2>
            <p>맡은 책임과 결과를 뒷받침하는 기술만 추렸습니다.</p>
            <ul class="tag-list">
              {project.data.stack.map((technology) => <li>{technology}</li>)}
            </ul>
          </section>
        </aside>
      </div>

      <section class="project-navigation" aria-labelledby="project-navigation-title">
        <h2 id="project-navigation-title">다른 프로젝트</h2>
        <div class="project-navigation__links">
          {
            previousProject && (
              <a class="text-link" href={`/projects/${previousProject.slug}/`}>
                이전 · {previousProject.title}
              </a>
            )
          }
          <a class="text-link" href="/#projects">전체 프로젝트</a>
          {
            nextProject && (
              <a class="text-link" href={`/projects/${nextProject.slug}/`}>
                다음 · {nextProject.title}
              </a>
            )
          }
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
