---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DemoAccessRequest from "../../components/DemoAccessRequest.astro";
import NewWindowLink from "../../components/NewWindowLink.astro";
import TagList from "../../components/TagList.astro";
import { getJobStatusContent, resolveJobStatusCode } from "../../data/job-status";
import { siteMetadata } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface ProjectNavigationTarget {
  slug: string;
  title: string;
}

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (leftProject, rightProject) => leftProject.data.order - rightProject.data.order,
  );
  const toNavigationTarget = (
    project: CollectionEntry<"projects"> | undefined,
  ): ProjectNavigationTarget | null => {
    if (!project) {
      return null;
    }

    return {
      slug: project.id,
      title: project.data.title,
    };
  };

  return projects.map((project, projectIndex) => ({
    params: { slug: project.id },
    props: {
      nextProject: toNavigationTarget(projects[projectIndex + 1]),
      previousProject: toNavigationTarget(projects[projectIndex - 1]),
      project,
    },
  }));
}

interface Props {
  nextProject: ProjectNavigationTarget | null;
  previousProject: ProjectNavigationTarget | null;
  project: CollectionEntry<"projects">;
}

const { nextProject, previousProject, project } = Astro.props;
const { Content } = await render(project);
const jobStatus = getJobStatusContent(
  "ko",
  resolveJobStatusCode(import.meta.env.PORTFOLIO_JOB_STATUS),
);
const featuredProject = nextProject ?? previousProject;
const featuredProjectDirection = nextProject ? "다음 프로젝트" : "이전 프로젝트";
---

<BaseLayout
  title={`${project.data.title} | ${siteMetadata.title}`}
  description={project.data.summary}
>
  <main id="main-content" class="project-main">
    <article class="site-shell project-article">
      <nav class="breadcrumb" aria-label="현재 위치">
        <ol>
          <li><a href="/#projects">프로젝트 목록</a></li>
          <li aria-current="page"><span>{project.data.title}</span></li>
        </ol>
      </nav>

      <header class="project-header">
        <p class="eyebrow project-classification">{project.data.classification}</p>
        <h1>{project.data.title}</h1>
        <p class="project-summary">{project.data.summary}</p>

        <dl class="project-facts">
          <div>
            <dt>역할</dt>
            <dd>{project.data.role}</dd>
          </div>
          <div>
            <dt>기여 범위</dt>
            <dd>{project.data.contribution}</dd>
          </div>
          <div>
            <dt>초점</dt>
            <dd>{project.data.focus}</dd>
          </div>
        </dl>
      </header>

      <div class="project-review-grid">
        <div class="prose">
          <Content />
        </div>

        <aside
          class="project-supporting"
          aria-label={project.data.demoAccess && jobStatus.acceptsEmailContact
            ? "프로젝트 검토 링크, 데모 로그인과 지원 기술"
            : "프로젝트 검토 링크와 지원 기술"}
        >
          {
            project.data.links.length > 0 && (
              <section class="project-links" aria-labelledby="project-links-title">
                <h2 id="project-links-title">검토 링크</h2>
                <p>
                  제공된 저장소, 배포 또는 문서 링크에서 이 프로젝트의 범위와 결과를 확인할 수
                  있습니다.
                </p>
                <ul>
                  {project.data.links.map((link, linkIndex) => (
                    <li>
                      <NewWindowLink
                        class:list={["button-link", { "button-link--secondary": linkIndex > 0 }]}
                        href={link.href}
                        accessibleLabel={`${project.data.title} ${link.label}`}
                      >
                        {link.label}
                      </NewWindowLink>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            project.data.demoAccess && jobStatus.acceptsEmailContact && (
              <DemoAccessRequest projectId={project.id} projectTitle={project.data.title} />
            )
          }

          <section class="project-stack" aria-labelledby="project-stack-title">
            <h2 id="project-stack-title">지원 기술</h2>
            <p>맡은 책임과 결과를 뒷받침하는 기술만 추렸습니다.</p>
            <TagList items={project.data.stack} />
          </section>
        </aside>
      </div>

      <section class="project-navigation" aria-labelledby="project-navigation-title">
        <div class="project-navigation__header">
          <h2 id="project-navigation-title">프로젝트 탐색</h2>
        </div>
        {
          featuredProject && (
            <a
              class="project-navigation__featured"
              href={`/projects/${featuredProject.slug}/`}
              aria-label={`${featuredProjectDirection}: ${featuredProject.title}`}
            >
              <span class="project-navigation__direction">{featuredProjectDirection}</span>
              <strong>{featuredProject.title}</strong>
              <span class="project-navigation__arrow" aria-hidden="true">
                {nextProject ? "→" : "←"}
              </span>
            </a>
          )
        }
        <div class="project-navigation__utilities">
          {
            previousProject && nextProject && (
              <a class="text-link" href={`/projects/${previousProject.slug}/`}>
                <span aria-hidden="true">←</span>
                이전 프로젝트
              </a>
            )
          }
          <a class="text-link project-navigation__index" href="/#projects">프로젝트 목록</a>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
