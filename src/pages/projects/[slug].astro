---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | 개발자 김용범의 포트폴리오`}
  description={project.data.summary}
>
  <main id="main-content" class="project-main">
    <article class="site-shell project-article">
      <nav class="breadcrumb" aria-label="현재 위치">
        <ol>
          <li><a href="/">포트폴리오</a></li>
          <li aria-current="page">{project.data.title}</li>
        </ol>
      </nav>

      <header class="project-header">
        <p class="eyebrow">{project.data.role}</p>
        <h1>{project.data.title}</h1>
        <p class="project-summary">{project.data.summary}</p>

        <dl class="project-facts">
          <div>
            <dt>역할</dt>
            <dd>{project.data.role}</dd>
          </div>
          <div>
            <dt>초점</dt>
            <dd>{project.data.focus}</dd>
          </div>
        </dl>

        <ul class="tag-list">
          {project.data.stack.map((technology) => <li>{technology}</li>)}
        </ul>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        project.data.links.length > 0 && (
          <section class="project-links" aria-labelledby="project-links-title">
            <h2 id="project-links-title">관련 링크</h2>
            <ul>
              {project.data.links.map((link) => (
                <li>
                  <a class="button-link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <aside class="next-step" aria-labelledby="next-step-title">
        <h2 id="next-step-title">다음 탐색</h2>
        <p>다른 프로젝트와 전체 역량은 landing page에서 이어서 볼 수 있습니다.</p>
        <a class="text-link" href="/#projects">프로젝트 목록으로 이동</a>
      </aside>
    </article>
  </main>
</BaseLayout>
