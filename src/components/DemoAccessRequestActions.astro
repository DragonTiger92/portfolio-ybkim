---
import { createDemoAccessRequest } from "../data/demo-access";
import NewWindowLink from "./NewWindowLink.astro";

interface Props {
  presentation: "card" | "detail";
  projectTitle: string;
}

const { presentation, projectTitle } = Astro.props;
const request = createDemoAccessRequest(projectTitle);
const isDetail = presentation === "detail";
---

<NewWindowLink
  class:list={[{ "button-link button-link--secondary": isDetail, "text-link": !isDetail }]}
  href={request.gmailUrl}
  accessibleLabel={`${projectTitle} 테스트 계정 요청 메일 작성`}
  windowLabel="Gmail 새 창"
  aria-haspopup="dialog"
  data-demo-access-trigger
>
  테스트 계정 요청
</NewWindowLink>
