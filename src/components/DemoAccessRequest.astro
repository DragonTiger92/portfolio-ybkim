---
import DemoAccessRequestActions from "./DemoAccessRequestActions.astro";
import DemoAccessRequestDialog from "./DemoAccessRequestDialog.astro";

interface Props {
  projectId: string;
  projectTitle: string;
}

const { projectId, projectTitle } = Astro.props;
const headingId = `demo-access-title-${projectId}`;
---

<section class="demo-access" aria-labelledby={headingId}>
  <h2 id={headingId}>데모 로그인</h2>
  <p>채용 검토용 테스트 계정은 요청을 확인한 뒤, 암호로 보호된 만료형 보안 링크로 전달합니다.</p>
  <DemoAccessRequestActions presentation="detail" {projectTitle} />
  <DemoAccessRequestDialog />
</section>
