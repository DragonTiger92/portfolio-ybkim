---
const homePrefix = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header">
  <div class="site-shell header-layout">
    <a class="site-identity" href="/" aria-label="김용범 포트폴리오 홈">
      <img class="site-logo" src="/assets/brand/logo-mark.svg" alt="" width="44" height="44" />
      <span class="site-identity__wordmark">김용범 포트폴리오</span>
    </a>

    <nav aria-label="주요 메뉴">
      <ul class="navigation-list">
        <li><a href={`${homePrefix}#projects`}>프로젝트</a></li>
        <li><a href={`${homePrefix}#skills`}>역량</a></li>
        <li><a href={`${homePrefix}#process`}>작업 방식</a></li>
      </ul>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
      <span class="theme-toggle__icon" aria-hidden="true"></span>
      <span data-theme-label>다크 모드</span>
    </button>
  </div>
</header>

<script src="../scripts/theme.ts"></script>
