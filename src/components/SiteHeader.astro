---
const isLandingPage = Astro.url.pathname === "/";
const homePrefix = isLandingPage ? "" : "/";
---

<header class="site-header" data-page-progress={isLandingPage ? "" : undefined}>
  <div class="site-shell header-layout">
    <a class="site-identity" href="/" aria-label="김용범 포트폴리오 홈">
      <img class="site-logo" src="/assets/brand/logo-mark.svg" alt="" width="44" height="44" />
      <span class="site-identity__wordmark">김용범 포트폴리오</span>
    </a>

    <nav aria-label="주요 메뉴">
      <ul class="navigation-list">
        <li>
          <a
            href={`${homePrefix}#intro`}
            data-section-link
            aria-current={isLandingPage ? "location" : undefined}>소개</a
          >
        </li>
        <li><a href={`${homePrefix}#projects`} data-section-link>프로젝트</a></li>
        <li><a href={`${homePrefix}#skills`} data-section-link>역량</a></li>
      </ul>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle>
      <span class="theme-toggle__icon" aria-hidden="true"></span>
      <span data-theme-label data-theme-action="dark">다크 모드</span>
      <span data-theme-label data-theme-action="light">라이트 모드</span>
    </button>
  </div>
</header>

<script src="../scripts/theme.ts"></script>
