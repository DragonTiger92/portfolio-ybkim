---
import { publicContact } from "../data/contact";
import NewWindowLink from "./NewWindowLink.astro";

interface Props {
  acceptsEmailContact: boolean;
}

const { acceptsEmailContact } = Astro.props;
---

<div class="contact-actions">
  <div class="action-list">
    {
      acceptsEmailContact && (
        <NewWindowLink
          class="button-link"
          href={publicContact.gmailComposeUrl}
          accessibleLabel="Gmail에서 메일 쓰기"
        >
          <span class="button-link__label">Gmail에서 메일 쓰기</span>
        </NewWindowLink>
      )
    }
    <NewWindowLink
      class="button-link button-link--secondary"
      href={publicContact.githubProfileUrl}
      accessibleLabel="GitHub 프로필 보기"
    >
      GitHub 프로필
    </NewWindowLink>
    <a
      class="button-link button-link--tertiary"
      href="/assets/resume/resume-ybkim.pdf"
      aria-label="이력서 PDF 다운로드"
      download
    >
      <span class="button-link__download-label">이력서 PDF 다운로드</span>
      <svg
        class="button-link__download-icon"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"></path>
      </svg>
    </a>
  </div>

  {
    acceptsEmailContact ? (
      <div class="contact-copy">
        <span class="contact-copy__label">이메일</span>
        <code id="public-email-address">{publicContact.email}</code>
        <button
          class="contact-copy__button"
          type="button"
          data-copy-email
          data-email={publicContact.email}
          aria-describedby="public-email-address copy-email-status"
        >
          주소 복사
        </button>
        <span
          id="copy-email-status"
          class="contact-copy__status"
          data-copy-email-status
          role="status"
          aria-live="polite"
          aria-atomic="true"
        />
      </div>
    ) : (
      <p class="contact-availability">현재 이메일 연락을 받고 있지 않습니다.</p>
    )
  }
</div>

{acceptsEmailContact && <script src="../scripts/contact.ts" />}
