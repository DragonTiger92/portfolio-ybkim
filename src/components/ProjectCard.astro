---
import { createDemoAccessRequestUrl } from "../data/demo-access";
import TagList from "./TagList.astro";
import NewWindowLink from "./NewWindowLink.astro";

interface ProjectLink {
  href: string;
  label: string;
  showOnCard: boolean;
}

interface Props {
  classification: string;
  demoAccess: boolean;
  featured: boolean;
  links: ProjectLink[];
  role: string;
  slug: string;
  summary: string;
  tags: string[];
  title: string;
}

const { classification, demoAccess, featured, links, role, slug, summary, tags, title } =
  Astro.props;
const cardLinks = links.filter((link) => link.showOnCard);
const demoAccessRequestUrl = demoAccess ? createDemoAccessRequestUrl(title) : undefined;
const classificationLabel =
  classification === "개인 공개 프로젝트" ? "개인 프로젝트" : "부트캠프 팀 프로젝트";
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <div class="project-card__content">
    <div class="project-card__heading">
      <p class="project-card__classification">{classificationLabel}</p>
      <h4><a href={`/projects/${slug}/`}>{title}</a></h4>
    </div>
    <p class="project-card__summary">{summary}</p>
    <dl class="project-card__role">
      <div>
        <dt>역할</dt>
        <dd>{role}</dd>
      </div>
    </dl>
  </div>

  <TagList items={tags} />

  <div class="project-card__links">
    <a class="text-link" href={`/projects/${slug}/`} aria-label={`${title} 상세 설명`}>상세 설명</a>
    {
      cardLinks.map((link) => (
        <NewWindowLink
          class="text-link"
          href={link.href}
          accessibleLabel={`${title} ${link.label}`}
        >
          {link.label}
        </NewWindowLink>
      ))
    }
    {
      demoAccessRequestUrl && (
        <NewWindowLink
          class="text-link"
          href={demoAccessRequestUrl}
          accessibleLabel={`${title} 테스트 계정 요청 메일 작성`}
          windowLabel="Gmail 새 창"
        >
          테스트 계정 요청
        </NewWindowLink>
      )
    }
  </div>
</article>
