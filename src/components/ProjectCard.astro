---
interface ProjectLink {
  href: string;
  label: string;
  showOnCard: boolean;
}

interface Props {
  classification: string;
  links: ProjectLink[];
  role: string;
  slug: string;
  summary: string;
  tags: string[];
  title: string;
}

const { classification, links, role, slug, summary, tags, title } = Astro.props;
const cardLinks = links.filter((link) => link.showOnCard);
---

<article class="project-card">
  <div class="project-card__content">
    <p class="eyebrow">{classification}</p>
    <h3><a href={`/projects/${slug}/`}>{title}</a></h3>
    <p class="project-card__summary">{summary}</p>
    <p class="project-card__role">{role}</p>
  </div>

  <ul class="tag-list">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <div class="project-card__links">
    <a class="text-link" href={`/projects/${slug}/`} aria-label={`${title} 상세 설명`}>상세 설명</a>
    {
      cardLinks.map((link) => (
        <a class="text-link" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </div>
</article>
