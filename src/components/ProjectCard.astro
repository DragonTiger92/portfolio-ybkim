---
import TagList from "./TagList.astro";

interface ProjectLink {
  href: string;
  label: string;
  showOnCard: boolean;
}

interface Props {
  cardNumber: string;
  classification: string;
  featured: boolean;
  links: ProjectLink[];
  role: string;
  slug: string;
  summary: string;
  tags: string[];
  title: string;
}

const { cardNumber, classification, featured, links, role, slug, summary, tags, title } =
  Astro.props;
const cardLinks = links.filter((link) => link.showOnCard);
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <div class="project-card__content">
    <div class="project-card__meta">
      <p class="eyebrow">{classification}</p>
      <span aria-hidden="true">{cardNumber}</span>
    </div>
    <h4><a href={`/projects/${slug}/`}>{title}</a></h4>
    <p class="project-card__summary">{summary}</p>
    <p class="project-card__role">{role}</p>
  </div>

  <TagList items={tags} />

  <div class="project-card__links">
    <a class="text-link" href={`/projects/${slug}/`} aria-label={`${title} 상세 설명`}>상세 설명</a>
    {
      cardLinks.map((link) => (
        <a class="text-link" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </div>
</article>
