---
import { createDemoAccessRequestUrl } from "../data/demo-access";

interface ProjectLink {
  href: string;
  label: string;
  showOnCard: boolean;
}

interface Props {
  cardNumber: string;
  classification: string;
  demoAccess: boolean;
  featured: boolean;
  links: ProjectLink[];
  role: string;
  slug: string;
  summary: string;
  tags: string[];
  title: string;
}

const {
  cardNumber,
  classification,
  demoAccess,
  featured,
  links,
  role,
  slug,
  summary,
  tags,
  title,
} = Astro.props;
const cardLinks = links.filter((link) => link.showOnCard);
const demoAccessRequestUrl = demoAccess ? createDemoAccessRequestUrl(title) : undefined;
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <div class="project-card__content">
    <div class="project-card__meta">
      <p class="eyebrow">{classification}</p>
      <span aria-hidden="true">{cardNumber}</span>
    </div>
    <h3><a href={`/projects/${slug}/`}>{title}</a></h3>
    <p class="project-card__summary">{summary}</p>
    <p class="project-card__role">{role}</p>
  </div>

  <ul class="tag-list">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <div class="project-card__links">
    <a class="text-link" href={`/projects/${slug}/`} aria-label={`${title} 상세 설명`}>상세 설명</a>
    {
      cardLinks.map((link) => (
        <a class="text-link" href={link.href}>
          {link.label}
        </a>
      ))
    }
    {
      demoAccessRequestUrl && (
        <a
          class="text-link"
          href={demoAccessRequestUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} 테스트 계정 요청 메일 작성(Gmail 새 창)`}
        >
          테스트 계정 요청 <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>
