---
import TagList from "./TagList.astro";
import NewWindowLink from "./NewWindowLink.astro";

interface ProjectLink {
  href: string;
  label: string;
  showOnCard: boolean;
}

interface Props {
  classification: string;
  featured: boolean;
  links: ProjectLink[];
  role: string;
  slug: string;
  summary: string;
  tags: string[];
  title: string;
}

const { classification, featured, links, role, slug, summary, tags, title } = Astro.props;
const cardLinks = links.filter((link) => link.showOnCard);
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <div class="project-card__content">
    <h4><a href={`/projects/${slug}/`}>{title}</a></h4>
    <p class="project-card__summary">{summary}</p>
    <dl class="project-card__role">
      <div>
        <dt>역할</dt>
        <dd>{role}</dd>
      </div>
    </dl>
  </div>

  <TagList items={[classification, ...tags]} />

  <div class="project-card__links">
    <a class="text-link" href={`/projects/${slug}/`} aria-label={`${title} 상세 설명`}>상세 설명</a>
    {
      cardLinks.map((link) => (
        <NewWindowLink
          class="text-link"
          href={link.href}
          accessibleLabel={`${title} ${link.label}`}
        >
          {link.label}
        </NewWindowLink>
      ))
    }
  </div>
</article>
