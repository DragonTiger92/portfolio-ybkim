{
  "name": "portfolio-ybkim",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:governance": "node --test scripts/*.test.mjs",
    "build:bundle": "vite build",
    "check": "pnpm typecheck && pnpm lint:strict && pnpm test:governance && pnpm format:check && pnpm build:bundle",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/css": "1.3.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@eslint/markdown": "8.0.2",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,mts,cts,css,json,jsonc,md}": [
      "pnpm exec eslint --fix --no-warn-ignored",
      "pnpm exec prettier --write"
    ],
    "**/*.{html,yml,yaml}": "pnpm exec prettier --write",
    ".prettierrc": "pnpm exec prettier --write"
  }
}
