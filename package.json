{
  "name": "portfolio-ybkim",
  "private": true,
  "version": "1.0.1",
  "license": "MIT AND LicenseRef-Portfolio-Materials-All-Rights-Reserved",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.10.0"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "typecheck:strict": "astro check --minimumFailingSeverity warning",
    "lint": "eslint .",
    "lint:docs": "eslint \"docs/**/*.md\" \".agents/**/*.md\" \"AGENTS.md\" --max-warnings 0",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:size": "node scripts/validate-file-size.mjs",
    "lint:size:docs:strict": "node scripts/validate-file-size.mjs --strict docs .agents AGENTS.md",
    "lint:size:strict": "node scripts/validate-file-size.mjs --strict",
    "format": "prettier . --write",
    "format:docs:check": "prettier \"docs/**/*.md\" \".agents/**/*.md\" \"AGENTS.md\" --check",
    "format:check": "prettier . --check",
    "test:governance": "node --test scripts/validate-pr-metadata.test.mjs scripts/validate-dependabot-owner-merge.test.mjs",
    "test:file-size": "node --test scripts/validate-file-size.test.mjs",
    "test:static-budget": "node --test scripts/validate-static-budget.test.mjs",
    "test:contact-availability": "node --test scripts/validate-contact-availability.test.mjs",
    "test:delivery": "node --test scripts/check-http-smoke.test.mjs scripts/create-artifact-manifest.test.mjs scripts/resolve-pages-deployment.test.mjs scripts/validate-artifact-manifest.test.mjs scripts/validate-dist-output.test.mjs scripts/validate-headers.test.mjs scripts/validate-release-request.test.mjs scripts/validate-reusable-workflow-secrets.test.mjs",
    "test:release-evidence": "node --test scripts/render-social-preview.test.mjs scripts/validate-cyclonedx-sbom.test.mjs scripts/validate-image-assets.test.mjs scripts/validate-scancode-report.test.mjs",
    "asset:social-preview": "node scripts/render-social-preview.mjs",
    "test:a11y": "pnpm build:bundle && playwright test",
    "test:a11y:run": "playwright test",
    "artifact:manifest": "node scripts/create-artifact-manifest.mjs",
    "artifact:validate": "node scripts/validate-artifact-manifest.mjs",
    "sbom:cyclonedx": "node node_modules/@cyclonedx/cdxgen/bin/cdxgen.js -t js --no-recurse --no-install-deps --fail-on-error --validate --spec-version 1.6 --json-pretty -o sbom.cdx.json . && node scripts/validate-cyclonedx-sbom.mjs sbom.cdx.json",
    "smoke:http": "node scripts/check-http-smoke.mjs",
    "validate:release-request": "node scripts/validate-release-request.mjs",
    "validate:dist-output": "node scripts/validate-dist-output.mjs",
    "validate:headers": "node scripts/validate-headers.mjs",
    "validate:image-assets": "node scripts/validate-image-assets.mjs",
    "validate:sbom": "node scripts/validate-cyclonedx-sbom.mjs",
    "validate:scancode": "node scripts/validate-scancode-report.mjs --expected-version 32.5.0",
    "validate:html": "html-validate dist --ext html",
    "validate:html:strict": "html-validate dist --ext html --max-warnings 0",
    "validate:standards": "vnu --also-check-css --skip-non-html dist",
    "validate:standards:strict": "vnu --Werror --also-check-css --skip-non-html dist",
    "validate:static-budget": "node scripts/validate-static-budget.mjs",
    "build:bundle": "astro build",
    "check:docs": "pnpm lint:docs && pnpm lint:size:docs:strict && pnpm format:docs:check",
    "check:static": "pnpm typecheck:strict && pnpm lint:strict && pnpm lint:size:strict && pnpm test:governance && pnpm test:file-size && pnpm test:static-budget && pnpm test:contact-availability && pnpm test:delivery && pnpm test:release-evidence && pnpm validate:headers && pnpm validate:image-assets && pnpm format:check && pnpm build:bundle && pnpm validate:dist-output && pnpm validate:static-budget && pnpm validate:html:strict && pnpm validate:standards:strict",
    "check": "pnpm check:static && pnpm test:a11y:run",
    "build": "astro check --minimumFailingSeverity warning && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@cyclonedx/cdxgen": "12.8.2",
    "@eslint/css": "1.4.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@playwright/test": "1.62.1",
    "@typescript-eslint/parser": "8.65.0",
    "astro": "7.1.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.6.0",
    "html-validate": "11.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vnu-jar": "26.6.14",
    "wrangler": "4.114.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,mts,cts,css,json,jsonc,md}": [
      "pnpm exec eslint --fix --no-warn-ignored",
      "pnpm exec prettier --write",
      "node scripts/validate-file-size.mjs"
    ],
    "**/*.astro": [
      "pnpm exec eslint --fix --no-warn-ignored",
      "pnpm exec prettier --write",
      "node scripts/validate-file-size.mjs"
    ],
    "**/*.{html,yml,yaml}": [
      "pnpm exec prettier --write",
      "node scripts/validate-file-size.mjs"
    ],
    "**/*.tf": "node scripts/validate-file-size.mjs",
    ".prettierrc": "pnpm exec prettier --write"
  }
}
